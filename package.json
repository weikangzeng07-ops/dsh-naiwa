{
  "name": "dsh-naiwa",
  "version": "0.1.0",
  "description": "奶蛙桌宠 for DSH Web: 原版 432 帧动画、眼神跟随、Q 弹形变、分裂分身与物理反弹堆积，复用 dsh-whale-widget 账本只读记账",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "naiwa"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "assets",
    "icon.svg",
    "cordis.patch.yml",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/test.mjs",
    "smoke": "node tools/smoke.mjs"
  },
  "license": "MIT"
}
